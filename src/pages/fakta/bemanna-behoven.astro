---
import Bas from '../../layouts/Bas.astro';
import m from '../../data/multiplikatorer.json';
import aku from '../../data/aku.json';
import kap from '../../data/kapacitet.json';
import el from '../../data/el.json';
import beg from '../../data/begransningar.json';
import handel from '../../data/handel.json';
import { indata, fr } from '../../lib/behov';
const d = indata();
const pc = (x: number) => x.toLocaleString('sv-SE', { maximumFractionDigits: 2 });
const nf = (n: number) => Math.round(n).toLocaleString('sv-SE');
const bygg = kap.sektorer.find((s) => s.namn === 'Byggverksamhet')!;
const ind = kap.sektorer.find((s) => s.namn === 'Tillverkningsindustri')!;
const elSist = el.ar[el.ar.length - 1];
const elNetto = (elSist.export - elSist.import) / 1000;
const handelAr = handel.ar[handel.ar.length - 1][0];
const klient = { d, elNetto, elAr: elSist.ar, byggAr: beg.bygg.ar };
---
<Bas titel="Bemanna behoven" beskrivning="Vad händer med arbetslösheten och statens budget om staten finansierar de behov som myndigheterna själva har räknat på?">
<div class="sub"><div class="band"><div class="wrap">
<a class="back" href="/#beh">← Behov</a>
<h1>Bemanna behoven</h1>
<p class="lead" style="opacity:1;margin:0">Vad händer om staten betalar för bostäderna, vården, försvaret, VA och underhållet som myndigheterna säger behövs? Hur mycket sjunker arbetslösheten, vad kostar det och räcker arbetskraften, importen, byggföretagen och elen?</p>
</div></div></div>
<div class="band"><div class="wrap">
<div class="calc bemanna" aria-labelledby="b-h">
<div>
<h2 id="b-h" style="font-size:20px;margin-bottom:12px">Arbetslösheten blir</h2>
<div class="big" id="b-big">0</div>
<div class="unit" id="b-unit"></div>
<div class="conv" id="b-conv"></div>
<p class="lyft" id="b-lyft" aria-live="polite" style="margin-top:20px"></p>
<p id="b-budget"></p>
</div>
<div class="inp">
<div><label for="b-andel">Alla behov samtidigt: <b id="b-av"></b></label><input id="b-andel" type="range" min="0" max="200" step="10" value="100">
<p class="note" style="margin:4px 0 0">Flyttar alla behov i samma proportion. Dra i varje behov nedan för att satsa olika mycket.</p></div>
<div>
<label id="b-rl">Riksbanken</label>
<div class="seg" id="b-rb" role="group" aria-labelledby="b-rl">
<button type="button" data-k="passiv" aria-pressed="true">Räntan ligger still</button>
<button type="button" data-k="aktiv" aria-pressed="false">Räntan höjs</button>
</div>
</div>
<button type="button" class="aterstall" id="b-reset">Återställ till hela behovet</button>
</div>
</div>

<div class="calc bemanna" style="margin-top:20px;display:block">
<h2 style="font-size:20px;margin-bottom:4px">Behoven, ett i taget</h2>
<p class="note" style="margin:0 0 16px">Varje reglage visar hur stor del av behovet som genomförs, från 0 till 300 procent. Siffran till höger är heltidsår per år, i snitt över tio år. Klimat och pensioner bygger på uppskattningar och är avstängda från början.</p>
<div class="brader" id="b-rader">
{d.poster.map((p, i) => (
<div class:list={['brad', { upp: p.uppskattad }]}>
<label for={`b-p${i}`}><span>{p.namn}{p.uppskattad ? ', uppskattat' : ''}</span> <b data-pct={i}></b></label>
<input id={`b-p${i}`} data-i={i} type="range" min="0" max="300" step="5" value={p.uppskattad ? 0 : 100}>
<span class="v" data-v={i}></span>
</div>
))}
<div class="brad ovr">
<label for="b-ovr"><span>Övriga satsningar</span> <b id="b-ovr-v"></b></label>
<input id="b-ovr" type="range" min="0" max="300" step="5" value="0">
<select id="b-ovr-i" aria-label="Typ av övrig satsning">
<option value="kons">Personal (som vård och skola)</option>
<option value="inv">Investeringar (som bygg)</option>
<option value="trans">Pengar till hushåll</option>
</select>
</div>
</div>
<h3 style="font-size:16px;margin:26px 0 6px">Hur mycket av de lediga som behövs</h3>
<p class="note" style="margin:0 0 8px">Hela stapeln är de omkring {nf(Math.round(((d.u - fr) / 100) * d.lf / 1000) * 1000)} personer som i dag är arbetslösa utöver friktionsnivån. Varje del visar hur många av dem ett behov ger jobb, enligt Konjunkturinstitutets multiplikatorer.</p>
<div class="bank" id="b-bank" role="img"></div>
<div class="bank-leg" id="b-bank-leg"></div>
</div>
</div></div>

<div class="band"><div class="wrap">
<h2>Andra begränsningar än arbetskraft</h2>
<p style="max-width:70ch">Arbetskraften är den viktigaste begränsningen, men inte den enda. Här är tre till som går att räkna på. Siffrorna följer reglagen ovan.</p>
<div class="grid3 beg">
<div>
<h3>Import</h3>
<p class="tal" id="b-imp"></p>
<p id="b-imp-t"></p>
<p class="note">{m.importandel.text} Källa: {m.importandel.kalla} Export och import: SCB, {handelAr}.</p>
</div>
<div>
<h3>Byggföretagen och material</h3>
<p class="tal" id="b-bygg"></p>
<p id="b-bygg-t"></p>
<p>I Konjunkturinstitutets barometer anger {bygg.efterfragan} av 100 byggföretag att svag efterfrågan begränsar dem, {bygg.arbetskraft} av 100 brist på arbetskraft och {bygg.material} av 100 brist på material. Inom industrin anger {ind.material} av 100 brist på material eller utrustning.</p>
<p class="note">Byggproduktion: {beg.bygg.kalla} Barometern: {kap.kalla} {bygg.period} och {ind.period}.</p>
</div>
<div>
<h3>El</h3>
<p class="tal">{pc(Math.round(elNetto * 10) / 10)} TWh</p>
<p>Så mycket mer el exporterade Sverige än vi importerade {elSist.ar}. Bostäder, vård och underhåll kräver lite el. Klimatomställningen kräver mycket. {beg.el.text}</p>
<p id="b-el" class="lyft" style="margin:8px 0 0"></p>
<p class="note">Källor: {el.kalla} {beg.el.kalla}</p>
</div>
</div>
</div></div>

<div class="band"><div class="wrap prose">
<h2>Så räknar vi</h2>
<ol>
<li><strong>Utgiften.</strong> Varje behov i fliken Behov räknas om till heltidsår per år, i snitt över tio år. Heltidsåren gånger 1 760 timmar och {d.kr} kronor per timme ger utgiften i kronor.</li>
<li><strong>Effekten på BNP och arbetslösheten.</strong> Utgiften delas med BNP och multipliceras med Konjunkturinstitutets multiplikatorer: offentliga investeringar för bostäder, VA, järnväg, väg och klimat, offentlig konsumtion för vård och omsorg, och transfereringar för pensionerna. Multiplikatorerna tar med jobb hos leverantörer och i privat sektor, men också det som läcker ut i import och sparande.</li>
<li><strong>Försvaret.</strong> {m.forsvar.text}</li>
<li><strong>Arbetskraften.</strong> Arbetslösheten kan inte bli lägre än friktionsnivån på {pc(fr)} procent. Om räkningen ger en lägre nivå saknas arbetskraft. Då måste människor och material frigöras från annan användning.</li>
<li><strong>Budgeten.</strong> När BNP ökar får staten in mer skatt och betalar mindre för arbetslösheten. {m.budgetelasticitet.text} Det som återstår är hur mycket statens underskott ökar.</li>
<li><strong>Importen.</strong> Utgiften för varje behov gånger importandelen för samma slags utgift. Importen från den ökade privata konsumtionen kommer till, så siffran är en undre gräns.</li>
</ol>
<h3>Vad underskottet betyder</h3>
<p>Statens underskott är kronor som staten betalar ut men inte drar tillbaka i skatt. De hamnar som inkomster och sparande hos hushåll och företag. Så länge det finns lediga arbetare och material är underskottet ingen begränsning. Begränsningen är arbetskraften. När den tar slut måste resurser frigöras, med skatter eller på andra sätt. <a href="/ramverket/">Läs ramverket</a>.</p>
<h3>Begränsningar</h3>
<ul>
<li>KI:s multiplikatorer är genomsnitt under normala förhållanden och gäller små förändringar. Här används de för stora belopp. Räkningen är linjär.</li>
<li>Arbetskraft är inte utbytbar. Sjuksköterskor, byggarbetare och ingenjörer kan ta slut långt innan arbetslösheten når friktionsnivån.</li>
<li>Byggbehoven jämförs med byggföretagens hela produktion. En del av behoven görs av andra, till exempel tillverkare av spår och rör.</li>
</ul>
<p class="note">Källor: {m.kalla} {m.forsvar.kalla} {m.budgetelasticitet.kalla} Arbetslöshet och arbetskraft: SCB, AKU, {aku.period}. BNP: SCB, {m.bnpAr}. Behoven: se fliken Behov på startsidan.</p>
</div></div>
<script type="application/json" id="b-data" set:html={JSON.stringify(klient)}></script>
<script>
  import { bemanna, type Indata } from '../../lib/bemanna';
  const $ = (id: string) => document.getElementById(id)!;
  const K = JSON.parse($('b-data').textContent || '{}') as { d: Indata; elNetto: number; elAr: number; byggAr: number };
  const d = K.d;
  let rb: 'aktiv' | 'passiv' = 'passiv';
  const total = $('b-andel') as HTMLInputElement;
  const rader = [...document.querySelectorAll<HTMLInputElement>('#b-rader input[data-i]')];
  const ovr = $('b-ovr') as HTMLInputElement;
  const ovrI = $('b-ovr-i') as HTMLSelectElement;
  const start = d.poster.map((p) => (p.uppskattad ? 0 : 1));
  // Varje behovs egen nivå relativt totalreglaget. Andelen = total × faktor.
  let faktor = [...start];
  const nf = (n: number) => Math.round(n).toLocaleString('sv-SE');
  const tusen = (n: number) => nf(Math.round(n / 1000) * 1000);
  const hundra = (n: number) => nf(Math.round(n / 100) * 100);
  const dec = (n: number) => n.toLocaleString('sv-SE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const andelar = () => faktor.map((f) => Math.min(3, (Number(total.value) / 100) * f));
  const fyll = (el: HTMLInputElement) => el.style.setProperty('--p', `${(Number(el.value) / Number(el.max)) * 100}%`);
  function draw() {
    const a = andelar();
    const r = bemanna(d, a, rb, { mdkr: Number(ovr.value), instrument: ovrI.value });
    $('b-av').textContent = `${total.value} procent`;
    rader.forEach((el, i) => {
      el.value = String(Math.round(a[i] * 100));
      fyll(el);
      document.querySelector(`[data-pct="${i}"]`)!.textContent = `${Math.round(a[i] * 100)} %`;
      document.querySelector(`[data-v="${i}"]`)!.textContent = hundra(a[i] * d.poster[i].heltidsarPerAr);
    });
    fyll(ovr); fyll(total);
    $('b-ovr-v').textContent = `${ovr.value} mdkr per år`;
    $('b-big').textContent = `${dec(r.nyU)} %`;
    $('b-unit').textContent = `i stället för ${dec(d.u)} procent i dag`;
    $('b-conv').innerHTML = [
      [`${nf(r.utgift)} mdkr`, 'ökade utgifter per år'],
      [tusen(r.farreArbetslosa), 'färre arbetslösa'],
      [`${nf(r.nettoMin)}–${nf(r.nettoMax)} mdkr`, 'större underskott per år, netto'],
    ].map(([b, s]) => `<div><b>${b}</b><span>${s}</span></div>`).join('');
    $('b-lyft').textContent = r.forKort > 0
      ? `Arbetskraften räcker inte. Det saknas omkring ${tusen(r.forKort)} personer. De måste frigöras från annan verksamhet, till exempel genom skatter som minskar annan efterfrågan eller genom effektivisering. Det motsvarar ungefär ${nf(r.frigoraMdkr)} miljarder kronor per år.`
      : r.utgift === 0 ? '' : `Arbetskraften räcker. Allt kan genomföras utan att resurser tas från annat håll. Det finns fortfarande omkring ${tusen(r.kvarOverFr)} personer arbetslösa utöver friktionsnivån.`;
    $('b-budget').textContent = r.utgift === 0 ? '' : `Av utgiften på ${nf(r.utgift)} miljarder kronor kommer ${nf(r.utgift - r.nettoMax)}–${nf(r.utgift - r.nettoMin)} miljarder tillbaka som skatt och lägre kostnader för arbetslöshet. Resten blir ett större underskott, alltså mer sparande hos hushåll och företag.`;
    // Avbytarbänken: varje behovs del av de lediga.
    const bank = d.u - d.fr;
    const namn = [...d.poster.map((p) => p.namn), 'Övriga satsningar'];
    const skala = Math.max(1, r.bankAndel);
    const delar = r.duPer.map((x, i) => ({ i, namn: namn[i], w: (-x / bank) * 100 / skala, upp: i < d.poster.length ? !!d.poster[i].uppskattad : false })).filter((x) => x.w > 0.05);
    $('b-bank').innerHTML = delar.map((x, k) => `<i class="${x.upp ? 'upp' : ''} n${k % 4}" style="width:${x.w}%" title="${x.namn}"></i>`).join('')
      + (r.bankAndel > 1 ? `<b class="grans" style="left:${100 / skala}%"></b>` : '');
    $('b-bank').setAttribute('aria-label', `Behoven använder ${Math.round(r.bankAndel * 100)} procent av de lediga.`);
    $('b-bank-leg').innerHTML = `<span><strong>${Math.round(r.bankAndel * 100)} procent</strong> av de lediga behövs${r.bankAndel > 1 ? '. Strecket visar var de tar slut' : ''}.</span> `
      + delar.map((x, k) => `<span><i class="${x.upp ? 'upp' : ''} n${k % 4}"></i>${x.namn}</span>`).join('');
    // Import
    $('b-imp').textContent = `${nf(r.import)} mdkr`;
    $('b-imp-t').textContent = `Så mycket ökar importen per år, minst. Sverige exporterade för ${nf(d.nettoexport)} miljarder kronor mer än vi importerade senaste året. Det motsvarar ${Math.round((r.import / d.nettoexport) * 100)} procent av det överskottet. Importen betalas med kronor. Om överskottet krymper mycket kan kronan försvagas och importen bli dyrare.`;
    // Bygg
    $('b-bygg').textContent = `${nf(r.bygg)} mdkr`;
    $('b-bygg-t').textContent = `Så mycket per år kostar bostäderna, VA och underhållet av väg och järnväg. Det är ${Math.round((r.bygg / d.byggMdkr) * 100)} procent av vad byggföretagen producerade ${K.byggAr} (${nf(d.byggMdkr)} miljarder kronor).`;
    // El
    const klimat = d.poster.findIndex((p) => p.namn === 'Klimatet');
    $('b-el').textContent = klimat >= 0 && a[klimat] > 0 ? 'Klimatet är med i räkningen. Då är elen en verklig begränsning: elproduktionen måste byggas ut i takt med att industrin går över till el.' : '';
    for (const b of document.querySelectorAll<HTMLButtonElement>('#b-rb button')) b.setAttribute('aria-pressed', String(b.dataset.k === rb));
  }
  total.addEventListener('input', draw);
  rader.forEach((el, i) => el.addEventListener('input', () => {
    let t = Number(total.value);
    if (t === 0) { faktor = faktor.map(() => 0); total.value = '100'; t = 100; }
    faktor[i] = Number(el.value) / t;
    draw();
  }));
  ovr.addEventListener('input', draw);
  ovrI.addEventListener('change', draw);
  $('b-reset').addEventListener('click', () => { faktor = [...start]; total.value = '100'; ovr.value = '0'; draw(); });
  $('b-rb').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('button'); if (b) { rb = b.dataset.k as 'aktiv' | 'passiv'; draw(); } });
  draw();
</script>
</Bas>
